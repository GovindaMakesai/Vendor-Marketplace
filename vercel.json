{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://vendor-marketplace-cmhd.onrender.com/health"
    },
    {
      "source": "/api/:path*",
      "destination": "https://vendor-marketplace-cmhd.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
