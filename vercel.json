{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "installCommand": "npm install --include=dev",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": { "service": "server" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
